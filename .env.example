# ─────────────────────────────────────────────────────────────────────────────
# Environment variables
#
#  • Local development:  copy to .env.local
#  • Production:         set these in your hosting provider (Vercel / App Hosting)
#                        — or in .env.production.local for local production builds.
#
# NEXT_PUBLIC_* values are embedded in the browser bundle. The Firebase web
# config is NOT a secret: access is enforced by firestore.rules / storage.rules.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# On Firebase App Hosting these are injected automatically and can be omitted.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Branding & public URL
NEXT_PUBLIC_APP_NAME=Jinasena Training Foundation
# NEXT_PUBLIC_SITE_URL=https://learn.example.com

# Server access to Firebase for the /api/delete route (cascading deletes). Automatic on Firebase
# App Hosting / Cloud Run; locally run `gcloud auth application-default login`;
# on other hosts set a service-account JSON key:
# FIREBASE_SERVICE_ACCOUNT=

# AI study assistant — Firebase AI Logic with the Vertex AI Gemini API.
# Enable it in Firebase console → AI Logic (Blaze plan). Defaults shown.
# NEXT_PUBLIC_GEMINI_MODEL=gemini-3.8-flash
# NEXT_PUBLIC_AI_LOCATION=global

# Optional: Firebase App Check (reCAPTCHA Enterprise site key). Recommended.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Local development only: a registered App Check debug token (App Check → Apps →
# Manage debug tokens). Without it, a new token is printed in the browser console.
# NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# ── Local development only ────────────────────────────────────────────────────
# Use the Firebase Emulator Suite instead of a real project (npm run emulators).
# With emulators, use NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-lms and
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-lms.appspot.com (other values can be any
# non-empty placeholder). Production builds refuse to run with this enabled.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
